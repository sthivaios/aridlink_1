// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Device {
  imei      String    @id
  name      String?
  tokenHash String
  approved  Boolean   @default(false)
  schedule  Json      @default("[]")
  firstSeen DateTime?
  lastSeen  DateTime?
  createdAt DateTime  @default(now())

  heartbeats  Heartbeat[]
  valveEvents ValveEvent[]
}

model Heartbeat {
  id                 Int      @id @default(autoincrement())
  imei               String
  rssi               Int?
  ber                Int?
  valveOpen          Boolean  @default(false)
  batteryVoltage     Decimal?
  cabinetTemperature Decimal?
  createdAt          DateTime @default(now())

  device Device @relation(fields: [imei], references: [imei], onDelete: Cascade)

  @@index([imei, createdAt])
}

model ValveEvent {
  id       Int       @id @default(autoincrement())
  imei     String
  openedAt DateTime
  closedAt DateTime?

  device Device @relation(fields: [imei], references: [imei], onDelete: Cascade)

  @@index([imei, openedAt])
}

model ApiKey {
  id        String   @id @default(cuid())
  keyPrefix String
  keyHash   String
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([keyPrefix])
}
